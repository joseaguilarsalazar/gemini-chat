# Copia este archivo como .env y completa los valores.
# El archivo .env NUNCA debe subirse al repositorio.

# ------------------------------------------------------------------ IA
# Puedes usar uno o ambos proveedores. Con ambos configurados, el usuario
# puede cambiar de motor desde la interfaz.

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Proveedor inicial: deepseek o gemini.
# Por defecto: deepseek si su clave está configurada; si no, gemini.
AI_PROVIDER=deepseek

# ------------------------------------------------------------------ Gemini
MODEL=gemini-3.1-flash-lite
# Modelos de respaldo si el principal está saturado (separados por coma)
MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.7-flash

# ------------------------------------------------------------------ DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Nivel de razonamiento: low, medium, high, max
DEEPSEEK_EFFORT=medium
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_MS=120000

# ------------------------------------------------------------------ servidor
HOST=0.0.0.0
PORT=3000

# Base de datos SQLite (se crea automáticamente)
DB_PATH=data/chat.db

# Cuántos mensajes previos se envían al modelo como contexto
HISTORY_LIMIT=20

# Longitud máxima de un mensaje del usuario
MAX_MESSAGE_LENGTH=4000

# Región e idioma de la tienda de Steam (pe = Perú, precios en soles)
STEAM_CC=pe
STEAM_LANG=spanish

# Tiempo máximo de espera para APIs externas, en milisegundos
HTTP_TIMEOUT_MS=20000

# ------------------------------------------------------------------ autenticación
SESSION_DAYS=30
COOKIE_SECURE=false

# ------------------------------------------------------------------ notificaciones (opcional)
# Enlace que se incluye en los mensajes
APP_URL=http://localhost:3000

# Telegram: crea un bot con @BotFather y obtén tu chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org

# Correo (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------------ vigilante de precios
# Cada cuánto se revisan los deseados (por defecto 6 horas)
PRICE_CHECK_INTERVAL_MS=21600000
# Cuántos juegos revisar por usuario en cada pasada
PRICE_CHECK_LIMIT=10
# Para desactivar el vigilante en desarrollo:
# PRICE_CHECK_DISABLED=true
